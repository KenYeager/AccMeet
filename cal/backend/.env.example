# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match exactly what you add in Google Cloud Console → Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# ── MongoDB (OPTIONAL — future production feature) ────────────────────────────
# For prototyping and testing, OAuth tokens are stored in-memory.
# To enable persistent MongoDB token storage (survives backend restarts),
# uncomment the variables below and point to your MongoDB instance.
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=accmeet_cal

# ── App ───────────────────────────────────────────────────────────────────────
# URL where the Next.js frontend is running (used for post-OAuth redirect)
FRONTEND_URL=http://localhost:3000

# Secret used to sign the session cookie (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret-key
