# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match exactly what you add in Google Cloud Console → Authorized redirect URIs
# Port 8000 is already used by MeetingPlatform's backend and 8001 by rag/backend.
GOOGLE_REDIRECT_URI=http://localhost:8002/api/calendar/callback

# ── MongoDB (persistent token storage — survives backend restarts) ────────────
# Set MONGODB_URI to enable it (db/__init__.py selects mongo vs in-memory based
# on whether this is set); leave unset to keep the in-memory dev default.
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=accmeet_cal

# ── App ───────────────────────────────────────────────────────────────────────
# URL where the Next.js frontend is running (used for post-OAuth redirect)
FRONTEND_URL=http://localhost:3002

# Secret used to sign the session cookie (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret-key
